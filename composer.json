{
    "name": "assessment/notification-system",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php scripts/lint.php"
    },
    "config": {
        "sort-packages": true
    },
    "description": "An event-driven notification service for SMS, email and push notifications.",
    "license": "proprietary"
}
